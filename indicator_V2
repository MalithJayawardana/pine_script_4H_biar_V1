//@version=6
indicator("MTF Confirmed Structure Bias [No Backplot]", shorttitle = "MTF Structure",
     overlay = true, max_labels_count = 500, max_lines_count = 10)

// ═══════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════
string GRP_S = "Structure"
int  tolTicks = input.int(2,    "Equal-Level Tolerance (ticks)",     minval = 0, group = GRP_S)
bool useInv   = input.bool(true, "Close-Confirmed Bias Invalidation",           group = GRP_S)

string GRP_P = "Pivot Settings (per timeframe)"
int left4   = input.int(2, "4H  Left",  minval = 1, inline = "p4",  group = GRP_P)
int right4  = input.int(2, "Right",     minval = 1, inline = "p4",  group = GRP_P)
int left1   = input.int(2, "1H  Left",  minval = 1, inline = "p1",  group = GRP_P)
int right1  = input.int(2, "Right",     minval = 1, inline = "p1",  group = GRP_P)
int left15  = input.int(2, "15m Left",  minval = 1, inline = "p15", group = GRP_P)
int right15 = input.int(2, "Right",     minval = 1, inline = "p15", group = GRP_P)
int left5   = input.int(2, "5m  Left",  minval = 1, inline = "p5",  group = GRP_P)
int right5  = input.int(2, "Right",     minval = 1, inline = "p5",  group = GRP_P)

string GRP_D = "Chart Display"
string chartTf    = input.string("4H",  "Chart Structure Timeframe", options = ["4H", "1H", "15m", "5m"], group = GRP_D)
bool   showSwings = input.bool(true,    "Show Structure Labels",                  group = GRP_D)
bool   showLevels = input.bool(true,    "Show Active High/Low Lines",             group = GRP_D)
bool   bgShade    = input.bool(false,   "Shade Background by Selected Bias",      group = GRP_D)
int    labelCap   = input.int(200,      "Label History Limit", minval = 10, maxval = 500, group = GRP_D)

string GRP_T = "Dashboard"
bool   showDash = input.bool(true,       "Show Dashboard", group = GRP_T)
string posSel   = input.string("Top Right", "Position",
     options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Middle Left"], group = GRP_T)
string sizeSel  = input.string("Small",  "Text Size", options = ["Tiny", "Small", "Normal", "Large"], group = GRP_T)

string GRP_C = "Colors"
color bullCol   = input.color(color.teal,   "Bullish",          group = GRP_C)
color bearCol   = input.color(color.maroon, "Bearish",          group = GRP_C)
color neutCol   = input.color(color.gray,   "Unclear / Wait",   group = GRP_C)
color hiLineCol = input.color(color.red,    "Active High Line", group = GRP_C)
color loLineCol = input.color(color.green,  "Active Low Line",  group = GRP_C)

// ═══════════════════════════════════════════════════════════════════════
// LOWER-TIMEFRAME SAFETY
// 5m and 15m are requested as HIGHER timeframes. That is only valid when
// the chart itself is 5m or lower. Anything above 5m is refused outright.
// ═══════════════════════════════════════════════════════════════════════
if timeframe.in_seconds(timeframe.period) > 300
    runtime.error("MTF Structure: this version must run on a standard time-based chart of 5 minutes or lower " +
         "(1m, 2m, 3m, 5m). On a higher chart timeframe the 5m/15m rows would be sampled from coarser data " +
         "and the non-repainting guarantee would be lost.")

bool chartIs5m = timeframe.period == "5"

// ═══════════════════════════════════════════════════════════════════════
// STRUCTURE ENGINE — one function, runs inside each timeframe's own context
//   off    : history offset applied to every returned value
//            1 → inside request.security() (confirmed-expression pattern)
//            0 → local chart-timeframe calculation (no extra delay)
//   commit : when false, no state is changed on this bar
//            true inside request.security(); barstate.isconfirmed locally
//
// State codes : 1 = HH/HL  -1 = LH/LL  2 = EQH/EQL  0 = first swing (SH/SL)
// Bias codes  : 1 = BULLISH  -1 = BEARISH  0 = UNCLEAR  99 = WAIT
// ═══════════════════════════════════════════════════════════════════════
f_structure(int leftBars, int rightBars, int off, bool commit) =>
    float tol = tolTicks * syminfo.mintick
    float ph  = ta.pivothigh(high, leftBars, rightBars)
    float pl  = ta.pivotlow(low,  leftBars, rightBars)

    // Highs
    var float lastH   = na
    var float prevH   = na
    var int   lastHT  = na      // original pivot candle open time
    var int   lastHCT = na      // close time of the candle that confirmed it
    var int   hState  = 0
    var int   hId     = 0
    // Lows
    var float lastL   = na
    var float prevL   = na
    var int   lastLT  = na
    var int   lastLCT = na
    var int   lState  = 0
    var int   lId     = 0
    // Invalidation latch
    var bool  invalidated = false
    var int   hIdAtInv    = 0
    var int   lIdAtInv    = 0

    if commit and not na(ph)
        prevH   := lastH
        lastH   := ph
        lastHT  := time[rightBars]
        lastHCT := time_close
        hState  := na(prevH) ? 0 : ph > prevH + tol ? 1 : ph < prevH - tol ? -1 : 2
        hId     += 1

    if commit and not na(pl)
        prevL   := lastL
        lastL   := pl
        lastLT  := time[rightBars]
        lastLCT := time_close
        lState  := na(prevL) ? 0 : pl > prevL + tol ? 1 : pl < prevL - tol ? -1 : 2
        lId     += 1

    // 1) Release the latch ONLY when new confirmed structure has arrived
    if invalidated and (hId != hIdAtInv or lId != lIdAtInv)
        invalidated := false

    // 2) Baseline bias from the two active confirmed swings
    int rawBias = hState == 1 and lState == 1 ? 1 : hState == -1 and lState == -1 ? -1 : 0

    // 3) Close-confirmed invalidation (wick alone never triggers this).
    //    Runs AFTER the release so a still-invalid new structure re-latches on the same bar.
    if commit and useInv and not invalidated and rawBias != 0
        bool closeBelowLow  = rawBias ==  1 and close < lastL
        bool closeAboveHigh = rawBias == -1 and close > lastH
        if closeBelowLow or closeAboveHigh
            invalidated := true
            hIdAtInv    := hId
            lIdAtInv    := lId

    int bias = na(prevH) or na(prevL) ? 99 : invalidated ? 0 : rawBias

    [lastH[off], lastHT[off], lastHCT[off], hState[off], hId[off],
     lastL[off], lastLT[off], lastLCT[off], lState[off], lId[off], bias[off]]

// ═══════════════════════════════════════════════════════════════════════
// TIMEFRAME REQUESTS — one tuple per timeframe, all offset by [1]
// ═══════════════════════════════════════════════════════════════════════
[h4P, h4T, h4C, h4S, h4Id, l4P, l4T, l4C, l4S, l4Id, b4] =
     request.security(syminfo.tickerid, "240", f_structure(left4, right4, 1, true),
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

[h1P, h1T, h1C, h1S, h1Id, l1P, l1T, l1C, l1S, l1Id, b1] =
     request.security(syminfo.tickerid, "60", f_structure(left1, right1, 1, true),
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

[h15P, h15T, h15C, h15S, h15Id, l15P, l15T, l15C, l15S, l15Id, b15] =
     request.security(syminfo.tickerid, "15", f_structure(left15, right15, 1, true),
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

// 5m: local when the chart IS 5m (no extra delay, commits at bar close),
//     otherwise requested as a higher timeframe (chart is 1m–3m).
//     Tuples cannot be placed inside a ternary, so both are evaluated and
//     selected field by field. The local call is a no-op on non-5m charts.
[h5PL, h5TL, h5CL, h5SL, h5IdL, l5PL, l5TL, l5CL, l5SL, l5IdL, b5L] =
     f_structure(left5, right5, 0, barstate.isconfirmed and chartIs5m)

[h5PR, h5TR, h5CR, h5SR, h5IdR, l5PR, l5TR, l5CR, l5SR, l5IdR, b5R] =
     request.security(syminfo.tickerid, "5", f_structure(left5, right5, 1, true),
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

float h5P  = chartIs5m ? h5PL  : h5PR
int   h5T  = chartIs5m ? h5TL  : h5TR
int   h5C  = chartIs5m ? h5CL  : h5CR
int   h5S  = chartIs5m ? h5SL  : h5SR
int   h5Id = chartIs5m ? h5IdL : h5IdR
float l5P  = chartIs5m ? l5PL  : l5PR
int   l5T  = chartIs5m ? l5TL  : l5TR
int   l5C  = chartIs5m ? l5CL  : l5CR
int   l5S  = chartIs5m ? l5SL  : l5SR
int   l5Id = chartIs5m ? l5IdL : l5IdR
int   b5   = chartIs5m ? b5L   : b5R

// ═══════════════════════════════════════════════════════════════════════
// SELECTED CHART-STRUCTURE TIMEFRAME
// ═══════════════════════════════════════════════════════════════════════
bool sel4  = chartTf == "4H"
bool sel1  = chartTf == "1H"
bool sel15 = chartTf == "15m"

float sHP  = sel4 ? h4P  : sel1 ? h1P  : sel15 ? h15P  : h5P
int   sHT  = sel4 ? h4T  : sel1 ? h1T  : sel15 ? h15T  : h5T
int   sHC  = sel4 ? h4C  : sel1 ? h1C  : sel15 ? h15C  : h5C
int   sHS  = sel4 ? h4S  : sel1 ? h1S  : sel15 ? h15S  : h5S
int   sHId = sel4 ? h4Id : sel1 ? h1Id : sel15 ? h15Id : h5Id
float sLP  = sel4 ? l4P  : sel1 ? l1P  : sel15 ? l15P  : l5P
int   sLT  = sel4 ? l4T  : sel1 ? l1T  : sel15 ? l15T  : l5T
int   sLC  = sel4 ? l4C  : sel1 ? l1C  : sel15 ? l15C  : l5C
int   sLS  = sel4 ? l4S  : sel1 ? l1S  : sel15 ? l15S  : l5S
int   sLId = sel4 ? l4Id : sel1 ? l1Id : sel15 ? l15Id : l5Id
int   sB   = sel4 ? b4   : sel1 ? b1   : sel15 ? b15   : b5

// A new swing is "available" on the first chart bar where the id changes
bool newHigh = nz(sHId) > 0 and nz(sHId) != nz(sHId[1])
bool newLow  = nz(sLId) > 0 and nz(sLId) != nz(sLId[1])

// ═══════════════════════════════════════════════════════════════════════
// TEXT / COLOR HELPERS
// ═══════════════════════════════════════════════════════════════════════
f_hiText(int s)   => s == 1 ? "HH" : s == -1 ? "LH" : s == 2 ? "EQH" : "SH"
f_loText(int s)   => s == 1 ? "HL" : s == -1 ? "LL" : s == 2 ? "EQL" : "SL"
f_stateCol(int s) => s == 1 ? bullCol : s == -1 ? bearCol : neutCol
f_biasText(int b) => b == 1 ? "BULLISH" : b == -1 ? "BEARISH" : b == 99 ? "WAIT" : "UNCLEAR"
f_biasCol(int b)  => b == 1 ? bullCol : b == -1 ? bearCol : neutCol
f_fmt(int t)      => str.format_time(t, "yyyy-MM-dd HH:mm", syminfo.timezone)

// ═══════════════════════════════════════════════════════════════════════
// STRUCTURE LABELS — drawn when the information becomes available,
// anchored at the original pivot time. Oldest labels deleted past the cap.
// ═══════════════════════════════════════════════════════════════════════
var label[] labelPool = array.new_label()

f_addLabel(label l) =>
    array.push(labelPool, l)
    if array.size(labelPool) > labelCap
        label.delete(array.shift(labelPool))

if showSwings and newHigh
    string tip = chartTf + " swing high" +
         "\nPivot candle: "   + f_fmt(sHT) +
         "\nConfirmed at: "   + f_fmt(sHC) +
         "\nDisplayed from: " + f_fmt(time)
    f_addLabel(label.new(sHT, sHP, chartTf + " " + f_hiText(sHS), xloc = xloc.bar_time,
         style = label.style_label_down, color = f_stateCol(sHS), textcolor = color.white,
         size = size.tiny, tooltip = tip))

if showSwings and newLow
    string tip = chartTf + " swing low" +
         "\nPivot candle: "   + f_fmt(sLT) +
         "\nConfirmed at: "   + f_fmt(sLC) +
         "\nDisplayed from: " + f_fmt(time)
    f_addLabel(label.new(sLT, sLP, chartTf + " " + f_loText(sLS), xloc = xloc.bar_time,
         style = label.style_label_up, color = f_stateCol(sLS), textcolor = color.white,
         size = size.tiny, tooltip = tip))

// ═══════════════════════════════════════════════════════════════════════
// ACTIVE CONFIRMED HIGH / LOW — two reusable rays, no price tags
// ═══════════════════════════════════════════════════════════════════════
var line hiLine = na
var line loLine = na

if showLevels and barstate.islast
    if not na(sHP)
        if na(hiLine)
            hiLine := line.new(sHT, sHP, time, sHP, xloc = xloc.bar_time, extend = extend.right,
                 color = hiLineCol, width = 1, style = line.style_dashed)
        else
            line.set_xy1(hiLine, sHT, sHP)
            line.set_xy2(hiLine, time, sHP)
    if not na(sLP)
        if na(loLine)
            loLine := line.new(sLT, sLP, time, sLP, xloc = xloc.bar_time, extend = extend.right,
                 color = loLineCol, width = 1, style = line.style_dashed)
        else
            line.set_xy1(loLine, sLT, sLP)
            line.set_xy2(loLine, time, sLP)

// ═══════════════════════════════════════════════════════════════════════
// OPTIONAL BACKGROUND SHADING (default OFF)
// ═══════════════════════════════════════════════════════════════════════
color shadeCol = sB == 1 ? color.new(bullCol, 90) : sB == -1 ? color.new(bearCol, 90) : color(na)
bgcolor(bgShade ? shadeCol : color(na))

// ═══════════════════════════════════════════════════════════════════════
// DASHBOARD — one table, created once, cells updated on the last bar only
// ═══════════════════════════════════════════════════════════════════════
f_pos(string p) =>
    p == "Top Right"     ? position.top_right    :
     p == "Top Left"     ? position.top_left     :
     p == "Bottom Right" ? position.bottom_right :
     p == "Bottom Left"  ? position.bottom_left  :
     p == "Middle Right" ? position.middle_right : position.middle_left

string txtSize = sizeSel == "Tiny" ? size.tiny : sizeSel == "Small" ? size.small :
     sizeSel == "Normal" ? size.normal : size.large

var table dash = table.new(f_pos(posSel), 3, 5,
     bgcolor = color.new(color.black, 15), frame_width = 1, frame_color = color.new(color.gray, 60),
     border_width = 1, border_color = color.new(color.gray, 75))

f_row(int row, string name, int hS, int lS, int b, bool isSelected) =>
    string st = b == 99 ? "WAIT" : f_hiText(hS) + " / " + f_loText(lS)
    table.cell(dash, 0, row, name, text_color = isSelected ? color.white : color.new(color.white, 30),
         text_size = txtSize, text_halign = text.align_left,
         bgcolor = isSelected ? color.new(color.white, 88) : color(na))
    table.cell(dash, 1, row, st, text_color = color.new(color.white, 10),
         text_size = txtSize, text_halign = text.align_center)
    table.cell(dash, 2, row, f_biasText(b), text_color = f_biasCol(b),
         text_size = txtSize, text_halign = text.align_right)

if showDash and barstate.islast
    color hdr = color.new(color.white, 45)
    table.cell(dash, 0, 0, "TF",        text_color = hdr, text_size = txtSize, text_halign = text.align_left)
    table.cell(dash, 1, 0, "STRUCTURE", text_color = hdr, text_size = txtSize, text_halign = text.align_center)
    table.cell(dash, 2, 0, "BIAS",      text_color = hdr, text_size = txtSize, text_halign = text.align_right)
    f_row(1, "4H",  h4S,  l4S,  b4,  sel4)
    f_row(2, "1H",  h1S,  l1S,  b1,  sel1)
    f_row(3, "15m", h15S, l15S, b15, sel15)
    f_row(4, "5m",  h5S,  l5S,  b5,  chartTf == "5m")

// ═══════════════════════════════════════════════════════════════════════
// ALERTS — fire once, on the first bar where a new confirmed bias is available.
// Set each alert to "Once per bar close".
// ═══════════════════════════════════════════════════════════════════════
alertcondition(b4  ==  1 and nz(b4[1])  !=  1, "4H Bias → Bullish",  "4H structure bias turned BULLISH")
alertcondition(b4  == -1 and nz(b4[1])  != -1, "4H Bias → Bearish",  "4H structure bias turned BEARISH")
alertcondition(b1  ==  1 and nz(b1[1])  !=  1, "1H Bias → Bullish",  "1H structure bias turned BULLISH")
alertcondition(b1  == -1 and nz(b1[1])  != -1, "1H Bias → Bearish",  "1H structure bias turned BEARISH")
alertcondition(b15 ==  1 and nz(b15[1]) !=  1, "15m Bias → Bullish", "15m structure bias turned BULLISH")
alertcondition(b15 == -1 and nz(b15[1]) != -1, "15m Bias → Bearish", "15m structure bias turned BEARISH")
alertcondition(b5  ==  1 and nz(b5[1])  !=  1, "5m Bias → Bullish",  "5m structure bias turned BULLISH")
alertcondition(b5  == -1 and nz(b5[1])  != -1, "5m Bias → Bearish",  "5m structure bias turned BEARISH")
